            "options": {
                "afterRender": "const subscription = context.grafana.eventBus.subscribe({ type: 'data-hover' }, (data) => {\r\n\r\n  const hoverIndex = data.payload.rowIndex;\r\n  const series = context.panelData.series[0];\r\n  const imageField = series.fields.find(f => f.name === \"image_key\");\r\n  const imageKey = imageField.values.get(hoverIndex);\r\n  const filename = imageKey.split(\"/\").pop();\r\n\r\n  // remove extension\r\n  const base = filename.replace(\".jpg\", \"\");\r\n\r\n  // extract parts\r\n  const year = base.substring(0, 4);\r\n  const month = base.substring(4, 6);\r\n  const day = base.substring(6, 8);\r\n  const hour = base.substring(8, 10);\r\n  const minute = base.substring(10, 12);\r\n  const second = base.substring(12, 14);\r\n\r\n  // build readable format\r\n  const dateTime = `${year}-${month}-${day} ${hour}:${minute}:${second}`;\r\n\r\n\r\n  const baseUrl = \"https://feeding-sample-images.s3.dualstack.eu-north-1.amazonaws.com/\"\r\n  const imageUrl = baseUrl + imageKey;\r\n  document.getElementById(\"hover_img\").src = imageUrl;\r\n  document.getElementById(\"img_label\").innerText = dateTime;\r\n\r\n});\r\n\r\n\r\n",
                "content": "<div style=\"width:100%; height:100%; position:relative;\">\r\n     <img id=\"hover_img\" style=\"width:100%; height:100%; object-fit:cover;\" />\r\n     <div id=\"img_label\" style=\"\r\n         width:100%;\r\n         position:absolute;\r\n         bottom:-20%;\r\n         left:50%;\r\n         transform:translateX(-50%);\r\n         background:rgba(0,0,0,0.5);\r\n         color:white;\r\n         padding:4px 10px;\r\n         border-radius:6px;\r\n         font-size:14px;\r\n         text-align:center\r\n       \">\r\n          image_name.jpg\r\n     </div>\r\n</div>",
