                    "editorMode": "code",
                    "format": "table",
                    "hide": false,
                    "rawQuery": true,
                    "rawSql": "WITH stats AS (\r\n  SELECT\r\n    MIN(humidity) AS min_val,\r\n    MAX(humidity) AS max_val\r\n  FROM feeding_samples\r\n  WHERE feeding_event_id = $feeding_event\r\n)\r\n\r\nSELECT\r\n  timestamp,\r\n  (humidity - stats.min_val) /\r\n  NULLIF(stats.max_val - stats.min_val, 0) AS humidity_norm\r\nFROM feeding_samples, stats\r\nWHERE feeding_event_id = $feeding_event\r\n  AND $__timeFilter(timestamp)\r\nORDER BY timestamp",
