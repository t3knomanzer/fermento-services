                    "editorMode": "code",
                    "format": "table",
                    "hide": false,
                    "rawQuery": true,
                    "rawSql": "WITH stats AS (\r\n  SELECT\r\n    MIN(temperature) AS min_val,\r\n    MAX(temperature) AS max_val\r\n  FROM feeding_samples\r\n  WHERE feeding_event_id = $feeding_event\r\n)\r\n\r\nSELECT\r\n  timestamp,\r\n  (temperature - stats.min_val) /\r\n  NULLIF(stats.max_val - stats.min_val, 0) AS temperature_norm\r\nFROM feeding_samples, stats\r\nWHERE feeding_event_id = $feeding_event\r\n  AND $__timeFilter(timestamp)\r\nORDER BY timestamp",
                    "refId": "A",
                    "sql": {
                        "columns": [
                            {
                                "parameters": [],
                                "type": "function"
                            }
                        ],
                        "groupBy": [
                            {
                                "property": {
                                    "type": "string"
                                },
                                "type": "groupBy"
                            }
                        ],
                        "limit": 50
                    }
                },
                {
                    "dataset": "fermento",
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "cfcyc85av9pfka"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "hide": false,
                    "rawQuery": true,
                    "rawSql": "WITH stats AS (\r\n  SELECT\r\n    MIN(distance) AS min_val,\r\n    MAX(distance) AS max_val\r\n  FROM feeding_samples\r\n  WHERE feeding_event_id = $feeding_event\r\n)\r\n\r\nSELECT\r\n  timestamp,\r\n  (1 - (distance - stats.min_val) /\r\n  NULLIF(stats.max_val - stats.min_val, 0)) AS distance_norm\r\nFROM feeding_samples, stats\r\nWHERE feeding_event_id = $feeding_event\r\n  AND $__timeFilter(timestamp)\r\nORDER BY timestamp",
                    "refId": "B",
